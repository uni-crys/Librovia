# Copy to backend/.env and fill in values locally. Never commit backend/.env.
GOOGLE_BOOKS_API_KEY=

# Set to production on a deployed server. Production validates the sync token
# and rejects wildcard/localhost CORS origins during startup.
ENVIRONMENT=development

# Optional absolute path (default: backend/data/ebooks.db).
# LIBROVIA_DATABASE_PATH=/var/lib/librovia/ebooks.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Shared secret used only by the local Readmoo sync agent and the VPS backend.
# Generate a different long random value for your own installation.
READMOO_SYNC_TOKEN=

# Local-machine only: the Tailscale Serve URL of the VPS, without /api.
# Example: https://libreshelf.example.ts.net
READMOO_SYNC_VPS_URL=

# Optional: installed stable browser used for Readmoo automation.
# Leave empty for Playwright Chromium; set chrome or msedge per machine.
READMOO_BROWSER_CHANNEL=

# Optional SOCKS/HTTP proxy used only by Readmoo browser processes.
READMOO_BROWSER_PROXY=

# Optional SOCKS/HTTP proxy shared by Kobo login, wishlist, and library flows.
# Keep it stable across flows to avoid changing IP within one saved session.
KOBO_BROWSER_PROXY=
